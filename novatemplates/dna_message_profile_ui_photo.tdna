{'imageisle'}
</div>
</div>
</div>

<div>

<div className="elforge_message_profile_v1_name">
 <h4>{'profiletitle'}</h4>
</div>

<div className="elforge_message_profile_v1_meta">
{'data2'}
</div>

</div>

</div>



{/* CONTENT */}

<div className="elforge_message_profile_v1_body">


{/* LEFT PANEL */}

