    <div className="container-fluid bg-white p-4">

      {/* TOP HEADER */}
      <div className="d-flex justify-content-between align-items-center mb-4">
        <h4 className="fw-semibold mb-0">{'pagetitle'}</h4>

        <div className="d-flex gap-2">
          {'actionbuttons'}
        </div>
      </div>

      {/* SEARCH + ACTION BAR */}
      <div className="d-flex align-items-center justify-content-between mb-3">

        {/* SEARCH INPUT WITH BUTTON INSIDE */}
        <div className=" w-auto row p-0 m-0 " style={{ minWidth: "280px" }}>
        <div className="p-0 m-0 col-md-10">{'searchisle'}</div>
        <div className="p-0 m-0 col-md-2">{'refreshisle'}</div>
        
        </div>

        {/* RIGHT ACTIONS */}
        <div className="d-flex gap-2 align-items-center">

          {/* REFRESH BUTTON */}
 

          {/* ADD NEW */}
          {'addnewbtn'}

        </div>
      </div>

      {/* TABLE */}
      <div className="table-responsive">
      {'checkboxisle'}
      {'printisle'}
        <table className="table align-middle table-borderless">

          {/* GRID HEADERS */}
          <thead className="border-bottom small text-muted">
            {'grid:headers'}
          </thead>

          {/* GRID ROWS */}
          <tbody>
            {'grid:rows'}
          </tbody>

        </table>
        {'printbottom'}
      </div>

      {/* PAGINATION */}
      <div className="d-flex justify-content-end mt-3">
        {'pagination'}
      </div>

    </div>
  